<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Apolo.Desktop"
        x:Class="Apolo.Desktop.MainWindow"
        Title="Apolo" Width="1240" Height="780" MinWidth="860" MinHeight="520"
        Icon="avares://Apolo.Desktop/Assets/apolo.ico">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Menu Grid.Row="0" Name="MainMenu">
      <MenuItem Name="ProjectMenu" Header="Projeto">
        <MenuItem Name="OpenItem" Header="Abrir..." InputGesture="Ctrl+O" Click="OnOpen" />
        <MenuItem Name="RecentMenu" Header="Recentes" />
        <MenuItem Name="SettingsItem" Header="Configurações..." Click="OnSettings" />
        <Separator />
        <MenuItem Name="QuitItem" Header="Sair" Click="OnQuit" />
      </MenuItem>
      <MenuItem Name="HelpMenu" Header="Ajuda">
        <MenuItem Name="AboutItem" Header="Sobre o Apolo" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- playback, progress and volumes -->
    <Border Grid.Row="1" Classes="panel" Margin="8,4,8,6" Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="tool" Command="{Binding PreviousCommand}" ToolTip.Tip="Anterior">
            <Rectangle Width="22" Height="22" Fill="{StaticResource TextBrush}" OpacityMask="{x:Static local:Glyphs.Previous}" />
          </Button>
          <Button Classes="tool" Command="{Binding PauseCommand}" ToolTip.Tip="Pausar / continuar">
            <Rectangle Width="22" Height="22" Fill="{StaticResource TextBrush}" OpacityMask="{Binding PauseMask}" />
          </Button>
          <Button Classes="tool" Command="{Binding StopCommand}" ToolTip.Tip="Parar tudo">
            <Rectangle Width="22" Height="22" Fill="{StaticResource TextBrush}" OpacityMask="{x:Static local:Glyphs.Stop}" />
          </Button>
          <Button Classes="tool" Command="{Binding NextCommand}" ToolTip.Tip="Próxima">
            <Rectangle Width="22" Height="22" Fill="{StaticResource TextBrush}" OpacityMask="{x:Static local:Glyphs.Next}" />
          </Button>
          <Button Classes="tool" Command="{Binding RepeatCommand}" ToolTip.Tip="Repetir a música">
            <Rectangle Width="22" Height="22" Fill="{Binding RepeatBrush}" OpacityMask="{x:Static local:Glyphs.Repeat}" />
          </Button>
        </StackPanel>

        <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center" RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding MusicTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding MusicTime}" Classes="dim" Margin="12,0,0,0" />
          </Grid>
          <ProgressBar Name="MusicBar" Grid.Row="1" Height="10" Margin="0,6,0,0" Minimum="0"
                       Maximum="{Binding MusicLength}" Value="{Binding MusicPosition}"
                       Background="{StaticResource CardBrush}" Foreground="{StaticResource AccentBrush}"
                       PointerPressed="OnBarPressed" Cursor="Hand" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
          <StackPanel Width="120">
            <TextBlock Name="GlobalLabel" Text="Geral" Classes="dim" FontSize="12" />
            <Slider Minimum="0" Maximum="100" Value="{Binding Global}" />
          </StackPanel>
          <StackPanel Width="120">
            <TextBlock Name="MusicLabel" Text="Música" Classes="dim" FontSize="12" />
            <Slider Minimum="0" Maximum="100" Value="{Binding MusicVol}" />
          </StackPanel>
          <StackPanel Width="120">
            <TextBlock Name="SoundLabel" Text="Sons" Classes="dim" FontSize="12" />
            <Slider Minimum="0" Maximum="100" Value="{Binding SoundVol}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Name="LevelLabel" Text="Nivelar" Classes="dim" FontSize="12" />
            <ToggleSwitch IsChecked="{Binding LevelerOn}" OnContent="" OffContent="" MinWidth="0" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- folders and buttons -->
    <Grid Grid.Row="2" ColumnDefinitions="270,6,*" Margin="8,0,8,0">
      <Border Classes="panel" Padding="6">
        <TreeView ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" Background="Transparent">
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Rectangle Width="18" Height="18" Fill="{Binding Tint}" OpacityMask="{Binding IconMask}" IsVisible="{Binding HasIcon}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <Border Grid.Column="2" Classes="panel" Padding="6">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Classes="heading" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="card" Command="{Binding Click}" Width="172" Height="108">
                            <Border Classes="cardface" Background="{Binding Face}" BorderBrush="{Binding Edge}">
                              <Grid RowDefinitions="*,Auto">
                                <Panel>
                                  <Rectangle Width="38" Height="38" Fill="{Binding Tint}" OpacityMask="{Binding IconMask}" IsVisible="{Binding HasIcon}" />
                                  <Image Width="46" Height="46" Source="{Binding Picture}" IsVisible="{Binding HasPicture}" />
                                </Panel>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="3">
                                  <Rectangle Width="13" Height="13" Fill="{StaticResource DimBrush}" OpacityMask="{x:Static local:Glyphs.Music}" IsVisible="{Binding IsMusic}" />
                                  <Rectangle Width="13" Height="13" Fill="{StaticResource DimBrush}" OpacityMask="{x:Static local:Glyphs.Effect}" IsVisible="{Binding IsEffect}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- nothing open yet -->
          <StackPanel IsVisible="{Binding NoProject}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="520">
            <Image Source="avares://Apolo.Desktop/Assets/apolo.png" Width="96" Height="96" />
            <TextBlock Name="WelcomeTitle" Text="Bem-vindo ao Apolo" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Name="WelcomeText" TextWrapping="Wrap" TextAlignment="Center" Classes="dim" />
            <Button Name="WelcomeOpen" HorizontalAlignment="Center" Padding="22,10" Click="OnOpen" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- the sound effects which are playing -->
    <Border Grid.Row="3" Classes="panel" Margin="8,6,8,8" Padding="6" IsVisible="{Binding HasChips}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="chip" Width="250">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="tool" Width="30" Height="26" Command="{Binding PauseCommand}">
                      <Rectangle Width="14" Height="14" Fill="{StaticResource TextBrush}" OpacityMask="{Binding PauseMask}" />
                    </Button>
                    <Button Classes="tool" Width="30" Height="26" Command="{Binding RepeatCommand}">
                      <Rectangle Width="14" Height="14" Fill="{Binding RepeatBrush}" OpacityMask="{x:Static local:Glyphs.Repeat}" />
                    </Button>
                    <Button Classes="tool" Width="30" Height="26" Command="{Binding StopCommand}">
                      <Rectangle Width="14" Height="14" Fill="{StaticResource TextBrush}" OpacityMask="{x:Static local:Glyphs.Stop}" />
                    </Button>
                  </StackPanel>
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                               Background="#1F2129" Foreground="{StaticResource AccentBrush}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
