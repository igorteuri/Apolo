<Project Sdk="Microsoft.NET.Sdk">
  <!-- Automatic tests of Apolo (.NET 8). Run in the build (GitHub Actions). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\net8\Ares.Tags.Net8.csproj" />
    <ProjectReference Include="..\..\net8\Ares.TagsImport.Net8.csproj" />
    <ProjectReference Include="..\..\net8\Ares.Data.Net8.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the logic under test is compiled straight from the player sources (no window code) -->
    <Compile Include="..\..\src\Ares.Player\TrackText.cs" Link="Linked\TrackText.cs" />
    <Compile Include="..\..\src\Ares.Player\JsonText.cs" Link="Linked\JsonText.cs" />
    <Compile Include="..\..\src\Ares.Player\Player.Rights.cs" Link="Linked\Player.Rights.cs" />
    <Compile Include="..\..\src\Ares.CommonGUI\DropPlan.cs" Link="Linked\DropPlan.cs" />
    <Compile Include="..\..\src\Ares.Player\ImageUrlParser.cs" Link="Linked\ImageUrlParser.cs" />
    <Compile Include="..\..\src\Ares.Player\ImageBankIndex.cs" Link="Linked\ImageBankIndex.cs" />
    <Compile Include="..\..\src\Ares.Player\PackCatalog.cs" Link="Linked\PackCatalog.cs" />
    <Compile Include="..\..\src\Ares.Player\ProjectCredits.cs" Link="Linked\ProjectCredits.cs" />
  </ItemGroup>
</Project>
