<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="WindowColor">#17181D</Color>
    <Color x:Key="PanelColor">#1F2129</Color>
    <Color x:Key="CardColor">#2A2D38</Color>
    <Color x:Key="CardHoverColor">#363A4A</Color>
    <Color x:Key="AccentColor">#8E5BD1</Color>
    <Color x:Key="TextColor">#ECEDF3</Color>
    <Color x:Key="DimColor">#9AA0B4</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- the card of a button: the look is in the Border inside, so that the hover of the theme does not paint over it -->
  <Style Selector="Button.card">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pointerover Border.cardface">
    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
  </Style>
  <Style Selector="Border.cardface">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- small round buttons of the transport -->
  <Style Selector="Button.tool">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="8,14,8,2" />
  </Style>

  <!-- a heading which can be clicked (it opens the folder) -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="4,12,4,2" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
</Styles>
