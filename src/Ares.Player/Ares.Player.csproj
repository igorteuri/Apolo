<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Apolo</AssemblyName>
    <RootNamespace>Ares.Player</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>Resources\Ares.ico</ApplicationIcon>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="bin\**;obj\**" />
    <EmbeddedResource Include="Overlay\overlay.html" LogicalName="obs.overlay.html" />
    <EmbeddedResource Include="Overlay\config.html" LogicalName="obs.config.html" />
    <EmbeddedResource Include="Remote\remote.html" LogicalName="remote.html" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ares.CommonGUI\Ares.CommonGUI.csproj" />
    <ProjectReference Include="..\Ares.Data\Ares.Data.csproj" />
    <ProjectReference Include="..\Ares.Ipc\Ares.Ipc.csproj" />
    <ProjectReference Include="..\Ares.ModelChecks\Ares.ModelInfo.csproj" />
    <ProjectReference Include="..\Ares.Players\Ares.Players.csproj" />
    <ProjectReference Include="..\Ares.Playing\Ares.Playing.csproj" />
    <ProjectReference Include="..\Ares.Settings\Ares.Settings.csproj" />
    <ProjectReference Include="..\Ares.Tags\Ares.Tags.csproj" />
    <ProjectReference Include="..\Ares.TagsImport\Ares.TagsImport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
</Project>
