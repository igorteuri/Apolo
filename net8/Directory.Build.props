<Project>
  <!-- All the .NET 8 projects live in this one folder: each one needs its own "obj" folder,
       otherwise their restore files overwrite each other (random "missing reference" / "circular dependency" errors). -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <!-- Languages of the interface: Portuguese, German, English. The .NET runtime brings translations of its own messages in
       13 languages, each in a folder beside Apolo.exe; only the languages Apolo has are kept. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>pt;pt-BR;de;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
